<?xml version="1.0" encoding="utf-8"?>


<Defs>

    <GeneCategoryDef>
        <defName>Plasmids</defName>
        <label>plasmid</label>
        <displayPriorityInXenotype>900</displayPriorityInXenotype>
    </GeneCategoryDef>


    <GeneDef Name="PlasmidBase" Abstract="True">
        <description>A bundle of genes that can be passed on</description>
        <iconPath>UI/Icons/Genes/Plasmid</iconPath>
        <displayCategory>Plasmids</displayCategory>
        <label>Plasmid</label>
    </GeneDef>


    <!-- 
Ok so thank you for downloading my mod, I made this mod to be customizable so that
you can set up whatever you want.  Below is a nice "fill in the blank" version
of a plasmid so you can start making your own. 
-->
    <!--
<FPMPlasmids.PlasmidDef ParentName="PlasmidBase">
<defName> Replace with your plasmid name </defName>
<label> Replace with the in-game label </label>
<transfer>false</transfer>  this will delete the plasmid geneSet from the caster if true
<xenogene>false</xenogene>  this will have the genes be applied as xenogenes if true
<abilities>
    Add abilities here, e.g., <li>ImplantPlasmid</li> will allow you to spread plasmids
</abilities>
<geneSet>
    Genes to be added to the target and suppressed from the caster if transfer is set to true
</geneSet>
<suppressedGenes>
    Genes to be suppressed from the caster
</suppressedGenes>
</FPMPlasmids.PlasmidDef>
-->


    <GeneDef ParentName="PlasmidBase">
        <defName>TestPlasmid01</defName>
        <geneClass>FPMPlasmids.Plasmid</geneClass>
        <label>AAA plasmid</label>
        <iconPath>UI/Icons/Genes/Gene_Resurrect</iconPath>
        <abilities>
            <li>ImplantPlasmid</li>
        </abilities>
        <modExtensions>
            <li Class="FPMPlasmids.FPM_GeneExtension">
                <plasmidInfo>
                    <addedGenes>
                        <li>KindInstinct</li>
                        <li>Nearsighted</li>
                    </addedGenes>
                    <suppressedGenes>
                    </suppressedGenes>
                    <transferType>Apply</transferType>
                </plasmidInfo>
            </li>
        </modExtensions>
    </GeneDef>

    <GeneDef ParentName="PlasmidBase">
        <defName>TestPlasmid02</defName>
        <geneClass>FPMPlasmids.Plasmid</geneClass>
        <label>AAB plasmid</label>
        <iconPath>UI/Icons/Genes/Gene_Resurrect</iconPath>
        <abilities>
            <li>ImplantPlasmid</li>
        </abilities>
        <modExtensions>
            <li Class="FPMPlasmids.FPM_GeneExtension">
                <plasmidImplanter>true</plasmidImplanter>
                <plasmidInfo>
                    <addedGenes>
                        <li>WoundHealing_SuperFast</li>
                        <li>Immunity_SuperStrong</li>
                        <li>Superclotting</li>
                        <li>PsychicAbility_Dull</li>
                    </addedGenes>
                    <suppressedGenes>
                        <li>KindInstinct</li>
                        <li>Nearsighted</li>
                    </suppressedGenes>
                    <transferType>Transfer</transferType>
                </plasmidInfo>
            </li>
        </modExtensions>
    </GeneDef>


</Defs>